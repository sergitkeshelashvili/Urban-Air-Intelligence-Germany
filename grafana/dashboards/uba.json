    {
      "title": "CO · Station lines",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "TimescaleDB"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "rawSql": "SELECT m.timestamp AS time, s.station_name AS metric, AVG(m.value)::double precision AS value FROM measurements AS m JOIN stations AS s USING (station_id) WHERE m.component_id = '2' AND $__timeFilter(m.timestamp) AND s.city IN ($city) AND s.station_name IN ($station) GROUP BY m.timestamp, s.station_name ORDER BY time;",
          "format": "time_series",
          "datasource": {
            "type": "postgres",
            "uid": "TimescaleDB"
          },
          "refId": "A",
          "legendFormat": "{{metric}}"
        }
      ],
      "id": 9,
      "description": "CO eight-hour mean per reporting station; 2 stations currently report. mg/m³.",
      "fieldConfig": {
