    {
      "title": "Monitoring network · Germany",
      "type": "geomap",
      "datasource": {
        "type": "postgres",
        "uid": "TimescaleDB"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 12
      },
      "targets": [
        {
          "rawSql": "SELECT station_name, latitude, longitude, MAX(value) as max_value FROM measurements JOIN stations USING (station_id) WHERE $__timeFilter(timestamp) GROUP BY station_name, latitude, longitude;",
          "format": "table",
          "datasource": {
            "type": "postgres",
            "uid": "TimescaleDB"
          },
          "refId": "A"
        }
      ],
      "id": 10
    },
    {
      "title": "Station freshness & coverage",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "TimescaleDB"
      },
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 12
      },
      "targets": [
        {
          "rawSql": "SELECT station_name, component, MAX(timestamp) as latest_measurement, COUNT(timestamp) as total_observations FROM measurements JOIN stations USING (station_id) GROUP BY station_name, component ORDER BY latest_measurement ASC;",
          "format": "table",
          "datasource": {
            "type": "postgres",
            "uid": "TimescaleDB"
          },
          "refId": "A"
        }
      ],
      "id": 11
    },
    {
      "id": 12,
      "title": "Station coverage by pollutant",
      "type": "barchart",
      "description": "Number of distinct stations reporting each pollutant in the selected time range.",
      "datasource": {
        "type": "postgres",
        "uid": "TimescaleDB"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "TimescaleDB"
          },
          "format": "table",
          "rawSql": "SELECT m.component AS pollutant, COUNT(DISTINCT m.station_id)::bigint AS reporting_stations FROM measurements AS m WHERE $__timeFilter(m.timestamp) GROUP BY m.component ORDER BY reporting_stations DESC;"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisLabel": "Reporting stations",
            "axisPlacement": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "xField": "pollutant",
        "xTickLabelRotation": 0,
        "xTickLabelSpacing": 0,
        "showValue": "always",
        "stacking": "none",
        "groupWidth": 0.7,
        "barWidth": 0.94,
        "barRadius": 3,
        "fullHighlight": false,
        "tooltip": {
          "mode": "single",
          "sort": "desc"
        },
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        }
      }
    }
  ],
  "uid": "UrbanAirIntelligenceGermany",
  "description": "A cinematic overview of Germany air-quality measurements from UBA. Use city/station filters and time range to explore the reported data.",
  "style": "dark",
  "graphTooltip": 1,
  "tags": [
