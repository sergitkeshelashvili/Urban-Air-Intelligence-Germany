{
  "title": "Urban Air Intelligence Germany",
  "timezone": "browser",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "5m",
  "schemaVersion": 30,
  "templating": {
    "list": [
      {
        "name": "city",
        "type": "query",
        "datasource": {
          "type": "postgres",
          "uid": "TimescaleDB"
        },
        "query": "SELECT DISTINCT city FROM stations ORDER BY city;",
        "refresh": 1,
        "includeAll": true,
        "multi": true
      },
      {
        "name": "station",
        "type": "query",
        "datasource": {
          "type": "postgres",
          "uid": "TimescaleDB"
        },
        "query": "SELECT DISTINCT station_name FROM stations WHERE city IN ($city) ORDER BY station_name;",
        "refresh": 1,
        "includeAll": true,
        "multi": true
      },
      {
        "name": "pollutant",
        "type": "query",
        "datasource": {
          "type": "postgres",
          "uid": "TimescaleDB"
        },
        "query": "SELECT DISTINCT component FROM measurements ORDER BY component;",
        "refresh": 1,
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "title": "Last data refresh",
      "type": "stat",
      "datasource": {
        "type": "postgres",
        "uid": "TimescaleDB"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "rawSql": "SELECT EXTRACT(EPOCH FROM MAX(ingested_at)) * 1000 AS latest_update FROM measurements;",
          "format": "table",
          "datasource": {
            "type": "postgres",
            "uid": "TimescaleDB"
          },
          "refId": "A"
        }
      ],
      "id": 1,
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsIso"
        },
        "overrides": []
      }
    },
    {
      "title": "Active stations · 24h",
      "type": "stat",
      "datasource": {
        "type": "postgres",
        "uid": "TimescaleDB"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "rawSql": "SELECT COUNT(DISTINCT station_id) FROM measurements WHERE timestamp >= NOW() - INTERVAL '24 hours';",
          "format": "table",
          "datasource": {
            "type": "postgres",
            "uid": "TimescaleDB"
          },
          "refId": "A"
        }
      ],
      "id": 2
    },
    {
      "title": "Measurements in database",
      "type": "stat",
      "datasource": {
        "type": "postgres",
        "uid": "TimescaleDB"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "rawSql": "SELECT COUNT(*) FROM measurements;",
          "format": "table",
          "datasource": {
            "type": "postgres",
            "uid": "TimescaleDB"
          },
          "refId": "A"
        }
      ],
      "id": 3
    },
    {
      "title": "NO2 · Mean trend",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "TimescaleDB"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "rawSql": "SELECT m.timestamp AS time, AVG(m.value)::double precision AS \"Mean concentration\" FROM measurements AS m JOIN stations AS s USING (station_id) WHERE m.component_id = '5' AND $__timeFilter(m.timestamp) AND s.city IN ($city) AND s.station_name IN ($station) GROUP BY m.timestamp ORDER BY time;",
          "format": "time_series",
          "datasource": {
            "type": "postgres",
            "uid": "TimescaleDB"
          },
          "refId": "A",
          "legendFormat": "Mean across selected stations"
        }
      ],
      "id": 4,
      "description": "NO2 measurements; average across selected stations at each reported timestamp. UBA reporting is intermittent. µg/m³.",
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: µg/m³",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "#F43F5E"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 3,
            "fillOpacity": 12,
            "gradientMode": "opacity",
            "showPoints": "auto",
            "pointSize": 4,
            "axisPlacement": "auto",
            "axisLabel": "µg/m³",
            "axisColorMode": "text",
            "scaleDistribution": {
              "type": "linear"
            },
            "axisCenteredZero": false,
            "spanNulls": false,
            "thresholdsStyle": {
              "mode": "off"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        },
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
